# ZeptoMail API credentials — https://zeptomail.com
ZEPTO_API_KEY=your_zepto_api_key_here

# API base — regional endpoint. Detect yours: try api.zeptomail.com, .ae, .in, .eu
ZEPTO_API_BASE=https://api.zeptomail.ae

# Sender identity (must be a verified domain in ZeptoMail)
SENDER_EMAIL=no-reply@technioz.com
SENDER_NAME="Gaurav Bhatia"

# Email signature block appended via {{signature}} (defaults to SENDER_NAME)
# SIGNATURE="Gaurav Bhatia\nhttps://technioz.com"

# Daily sending cap (start LOW: 20-30/day for cold outreach)
DAILY_LIMIT=25

# Optional warm-up schedule: comma-separated daily caps for the first N days
# e.g. "10,15,20,25,25,30,30" = day1:10, day2:15, ... then steady at 30
WARMUP_SCHEDULE=10,15,20,25,30

# Where leads come from (relative to service root)
LEADS_CSV=../leads/leads-batch1.csv

# Pause (ms) between sends — paces sends out so they don't burst (recommended 2000-5000)
INTER_SEND_DELAY=3000

# Days after the first email before a follow-up is allowed
FOLLOWUP_DAYS=6

# Reply tracking: replies land at sender+tag@domain (check your domain's catch-all)
REPLY_TAG_ENABLED=true

# Unsubscribe footer (required for cold email compliance)
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# Server
PORT=4100

# Shared-secret bearer auth for mutating endpoints (POST /send, /campaign,
# /campaign/followup, /replied). If set, clients must send `Authorization: Bearer <key>`.
# If UNSET, endpoints stay OPEN (no auth) — intended for local dev only.
# A loud warning is logged at startup when unset. Set this in production.
OUTREACH_API_KEY=

# Webhook secret for POST /webhook/zeptomail. If set, requests must include
# ?token=<secret> OR an `X-Webhook-Secret: <secret>` header.
# If UNSET, the webhook is OPEN (anyone can POST) — dev only, warns at startup.
WEBHOOK_SECRET=

# Optional CORS allowlist (comma-separated origins) for mutating endpoints.
# If set, only these origins get Access-Control-Allow-Origin headers.
# If UNSET, no CORS headers are sent (current default behavior).
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Data directory for state files (sent.json, events.json). Defaults to ./data.
# Override with an absolute path for tests. Relative paths resolve from service root.
# DATA_DIR=./data

# Dry-run mode: logs instead of sending (safe for testing)
DRY_RUN=false

# Warm-up start date (ISO) — day 1 of the warm-up schedule.
# Set = explicit ramp anchor; unset = anchored to first recorded send day in data/sent.json.
# START_DATE=2026-08-05
