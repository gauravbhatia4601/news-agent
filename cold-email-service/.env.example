# ZeptoMail API credentials — https://zeptomail.com
ZEPTO_API_KEY=your_zepto_api_key_here

# API base — keep default unless your account is on a regional endpoint
ZEPTO_API_BASE=https://api.zeptomail.ae

# Sender identity (must be a verified domain in ZeptoMail)
SENDER_EMAIL=no-reply@technioz.com
SENDER_NAME="Gaurav Bhatia"

# Daily sending cap (start LOW: 20-30/day for cold outreach)
DAILY_LIMIT=25

# Optional warm-up schedule: comma-separated daily caps for the first N days
# e.g. "10,15,20,25,25,30,30" = day1:10, day2:15, ... then steady at 30
WARMUP_SCHEDULE=10,15,20,25,30

# Where leads come from (relative to service root)
LEADS_CSV=./leads.csv

# Reply tracking: replies land at sender+tag@domain (check your domain's catch-all)
REPLY_TAG_ENABLED=true

# Unsubscribe footer (required for cold email compliance)
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# Server
PORT=4100

# Dry-run mode: logs instead of sending (safe for testing)
DRY_RUN=false
