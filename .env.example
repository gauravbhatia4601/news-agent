APP_NAME="The AI Journal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
# Public frontend domain used for sitemaps, feeds, and robots.txt.
FRONTEND_URL=${APP_URL}

# Database (PostgreSQL) — managed by Coolify, not in this compose file
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=news_engine
DB_USERNAME=news_engine
DB_PASSWORD=

# Redis — URL-only config. Put the full Redis URL here and leave host/port/password empty.
# Example: redis://default:password@host:6379/0
REDIS_URL=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Cache / Session / Queue
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# AI Provider
AI_DEFAULT_PROVIDER=ollama_cloud
OPENROUTER_API_KEY=

# Ollama Cloud
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://api.ollama.com

# News Article Generation
NEWS_GENERATION_ENABLED=true
NEWS_GENERATION_PROVIDER=ollama_cloud
NEWS_GENERATION_MODEL=gemma4:31b-cloud
NEWS_GENERATION_TIMEOUT=300

# News Discovery
NEWS_DISCOVERY_LIMIT=3
NEWS_DISCOVERY_FRESH_HOURS=12
NEWS_DISCOVERY_SOURCES_PER_TOPIC=5
NEWS_DISCOVERY_SOURCES=google_rss
NEWS_DISCOVERY_PROVIDER=google_rss
NEWS_DISCOVERY_BRAVE_FALLBACK_THRESHOLD=8

# Brave Search LLM Context — used only as a fallback when Google RSS returns too few candidates.
# This keeps API usage within the 1k/month budget. Disable entirely by setting BRAVE_SEARCH_ENABLED=false.
BRAVE_SEARCH_ENABLED=true
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
BRAVE_SEARCH_TIMEOUT=20
BRAVE_SEARCH_LANG=en
BRAVE_SEARCH_FRESHNESS=pw
BRAVE_SEARCH_MAX_URLS=20
BRAVE_SEARCH_MAX_TOKENS=8192

# Images (disabled by default)
NEWS_IMAGES_ENABLED=false
NEWS_SOURCE_IMAGES_ENABLED=false
NEWS_AI_IMAGE_ENABLED=false

# Mail (optional)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@theaijournal.com
MAIL_FROM_NAME="The AI Journal"

# Docker / Coolify
FRONTEND_PORT=3000
