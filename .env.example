APP_NAME="The Daily Insight"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=news_engine
DB_USERNAME=news_engine
DB_PASSWORD=

# Cache / Session / Queue
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# AI Provider
AI_DEFAULT_PROVIDER=openrouter
OPENROUTER_API_KEY=

# News Article Generation
NEWS_GENERATION_ENABLED=true
NEWS_GENERATION_PROVIDER=openrouter
NEWS_GENERATION_MODEL=perplexity/sonar
NEWS_GENERATION_TIMEOUT=120

# News Discovery
NEWS_DISCOVERY_CATEGORIES=technology,sports,politics,entertainment,social
NEWS_DISCOVERY_LIMIT=5
NEWS_DISCOVERY_FRESH_HOURS=12
NEWS_DISCOVERY_SOURCES_PER_TOPIC=3
NEWS_DISCOVERY_SOURCES=google_rss

# Images (disabled by default)
NEWS_IMAGES_ENABLED=false
NEWS_SOURCE_IMAGES_ENABLED=false
NEWS_AI_IMAGE_ENABLED=false

# Docker / Coolify
FRONTEND_PORT=3000
