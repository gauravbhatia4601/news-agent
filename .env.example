APP_NAME="The Trust Journal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=${APP_URL}

# Database (PostgreSQL) — managed by Coolify, not in this compose file
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=news_engine
DB_USERNAME=news_engine
DB_PASSWORD=

# Redis — self-hosted or managed by Coolify, not in this compose file.
# If using Coolify's built-in Redis, set REDIS_HOST=coolify-redis and fill REDIS_PASSWORD.
# REDIS_URL can be left empty when REDIS_HOST/PORT/PASSWORD are provided.
REDIS_HOST=coolify-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_URL=

# Cache / Session / Queue
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# AI Provider
AI_DEFAULT_PROVIDER=ollama_cloud
OPENROUTER_API_KEY=

# Ollama Cloud
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://api.ollama.com

# News Article Generation
NEWS_GENERATION_ENABLED=true
NEWS_GENERATION_PROVIDER=ollama_cloud
NEWS_GENERATION_MODEL=gemma4:31b-cloud
NEWS_GENERATION_TIMEOUT=300

# News Discovery
NEWS_DISCOVERY_LIMIT=5
NEWS_DISCOVERY_FRESH_HOURS=12
NEWS_DISCOVERY_SOURCES_PER_TOPIC=5
NEWS_DISCOVERY_SOURCES=google_rss,brave_search
NEWS_DISCOVERY_PROVIDER=google_rss

# Brave Search LLM Context (used alongside Google RSS for discovery)
BRAVE_SEARCH_ENABLED=true
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
BRAVE_SEARCH_TIMEOUT=20
BRAVE_SEARCH_LANG=en
BRAVE_SEARCH_FRESHNESS=pw
BRAVE_SEARCH_MAX_URLS=20
BRAVE_SEARCH_MAX_TOKENS=8192

# Images (disabled by default)
NEWS_IMAGES_ENABLED=false
NEWS_SOURCE_IMAGES_ENABLED=false
NEWS_AI_IMAGE_ENABLED=false

# Mail (optional)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@thetrustjournal.com
MAIL_FROM_NAME="The Trust Journal"

# Docker / Coolify
FRONTEND_PORT=3000
